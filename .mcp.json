{
  "mcpServers": {
    "n8n-mcp": {
      "type": "http",
      "url": "your-server-url",
      "headers": {
        "Authorization": "Bearer your-oauth-token"
      } 
    },
    "elevenlabs": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "your-elevenlabs-api-key"
      }
    } 
  }
}